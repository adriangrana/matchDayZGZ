{
  "name": "matchday-zgz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "node scripts/patch-vinext-windows-static.mjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "prestart": "node scripts/patch-vinext-windows-static.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "sync:demo": "tsx scripts/sync-demo.ts",
    "sync:news": "tsx scripts/sync-news.ts",
    "sync:sports": "npm run sports:sync",
    "sports:sync": "node --env-file-if-exists=.env.local --import tsx scripts/sports-sync.ts",
    "sports:inspect": "node --env-file-if-exists=.env.local --import tsx scripts/sports-inspect.ts",
    "sports:test-sources": "node --env-file-if-exists=.env.local --import tsx scripts/sports-test-sources.ts",
    "sports:sync-badges": "node --import tsx scripts/sports-sync-badges.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.10.1",
    "next": "16.2.12",
    "pdfjs-dist": "^6.1.200",
    "postgres": "3.4.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
