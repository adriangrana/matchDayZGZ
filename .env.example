# Base de datos (solo servidor)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchday_zgz
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor gratuito principal
SPORTS_PROVIDER=free-web

# API-Football opcional y desactivado (solo servidor; no es necesario)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_SEASON=2024
API_FOOTBALL_TEAM_ID=
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_LEAGUE_NAME=
API_FOOTBALL_DAILY_LIMIT=50
SPORTS_FIXTURES_CACHE_HOURS=6
SPORTS_STANDINGS_CACHE_HOURS=12
SPORTS_METADATA_CACHE_HOURS=24
SPORTS_SYNC_INTERVAL_HOURS=6

# Noticias (solo servidor)
NEWS_FEEDS=
NEWS_DATA_MODE=real
NEWS_CACHE_MINUTES=30
NEWS_IMAGE_VALIDATION_LIMIT=18
NEWS_SYNC_SECRET=replace-with-a-long-random-secret

# Sincronización
DATA_STALE_AFTER_MINUTES=90

# URL pública (no contiene secretos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
